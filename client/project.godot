; Engine configuration file.

config_version=5

[application]

config/name="Glint"
config/description="Glint, the glass color card game. Go game server, Godot client."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
config/windows_native_icon="res://branding/icon.ico"
boot_splash/bg_color=Color(0.035, 0.04, 0.1, 1)
boot_splash/show_image=true
boot_splash/image="res://branding/splash.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/minimum_display_time=200
run/low_processor_mode=false

[autoload]

Net="*res://scripts/net.gd"
Profile="*res://scripts/profile.gd"
Settings="*res://scripts/settings.gd"
Audio="*res://scripts/audio.gd"
Online="*res://scripts/online.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/snap_controls_to_pixels=true

[rendering]

anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.08, 1)
