; Engine configuration file.

config_version=5

[application]

config/name="UNO Glass"
config/description="UNO with a Go game server and a glassmorphism Godot client."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
run/low_processor_mode=false

[autoload]

Net="*res://scripts/net.gd"
Profile="*res://scripts/profile.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/snap_controls_to_pixels=true

[rendering]

anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.08, 1)
